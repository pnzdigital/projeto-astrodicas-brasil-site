# AstroDicas Site — variáveis do canal web.
# Copie para .env (nunca versionado) ou configure no Coolify.
# O Telegram tem as próprias credenciais: não reaproveite nada daqui lá.

# --- Núcleo ---
DATABASE_URL=postgresql+psycopg://astrodicas@db:5432/astrodicas
SITE_SECRET_KEY=troque-por-um-segredo-longo
SITE_ORIGIN=https://astrodicas.pnzdigital.com.br,https://dash.astrodicas.pnzdigital.com.br
SITE_PUBLIC_URL=https://astrodicas.pnzdigital.com.br
PORTAL_URL=https://dash.astrodicas.pnzdigital.com.br/
COOKIE_SECURE=1

# --- Checkout Mercado Pago (Argentina) ---
# Painel MP > Suas integrações > Credenciais. TEST-* em homologação, APP_USR-* em produção.
MP_ACCESS_TOKEN=
# LEGADO: MP_PUBLIC_KEY era usado no Payment Brick (checkout transparente).
# Checkout Pro (redirect) não precisa. Mantém-se para compatibilidade reversa;
# remova se seu deploy já é Checkout Pro puro.
MP_PUBLIC_KEY=
# Painel MP > Webhooks > Clave secreta. Valida o header x-signature.
# Cada aplicação do MP tem a sua: a rota argentina
# (/api/webhooks/mercadopago/ar/notify) usa MP_WEBHOOK_SECRET_AR e é a que
# recebe as vendas de hoje. MP_WEBHOOK_SECRET serve só à rota legada
# (/api/webhooks/mercadopago/notify), mantida viva porque pagamentos abertos
# antes do deploy têm essa URL gravada e continuam sendo notificados nela.
# Enquanto MP_WEBHOOK_SECRET_AR não existir, a rota AR cai em MP_WEBHOOK_SECRET.
MP_WEBHOOK_SECRET_AR=
MP_WEBHOOK_SECRET=
MP_STATEMENT_DESCRIPTOR=ASTRODICAS
# Override raro (sandbox/homolog). Padrão já é a API pública do MP.
# MP_API_BASE=https://api.mercadopago.com
# Dias grátis do Diário Astral. Desde 08/08/2026 o trial é LOCAL e sem cartão:
# nasce em /api/trial/start e morre no expires_at do entitlement, sem passar
# pelo Mercado Pago. Mudar aqui só afeta trials NOVOS; os em andamento seguem
# o prazo com que nasceram, já gravado no banco.
TRIAL_DAYS=3

# --- Quem cobra em cada mercado ---
# Sem estas variáveis vale o padrão histórico: AR no Mercado Pago, BR na Cakto.
# Valores aceitos: mercadopago | cakto. Valor desconhecido cai no padrão e loga.
# Para o Brasil no Mercado Pago é preciso uma conta BRASILEIRA (MLB): contas do
# MP são presas ao país e a conta argentina (MLA) não cobra em BRL.
# CHECKOUT_PROVIDER_AR=mercadopago
# CHECKOUT_PROVIDER_BR=cakto

# --- Checkout GG Checkout (Brasil, padrão de mercado) ---
# Painel GG > Webhooks > Chave secreta.
GG_CHECKOUT_SECRET=
# JSON {"site:diario_astral": "https://checkout.gg.com/..."} — URL de checkout GG por product_id.
GG_CHECKOUT_URLS=
# JSON {"gg-uuid-do-produto": "site:diario_astral"} — mapeia UID GG ao product_id interno.
GG_PRODUCT_MAP=

# --- Checkout Cakto (legado — não é mais o padrão de nenhum mercado; ADMIN_PASSWORD e
# guard de produção ainda exigem CAKTO_WEBHOOK_SECRET setado, mesmo sem uso ativo) ---
CAKTO_WEBHOOK_SECRET=

# --- Crons do Coolify (POST /api/tasks/*) ---
# Header x-task-secret. Sem isto, cada rota de cron responde 503.
TASK_SECRET=

# --- E-mail transacional (Resend) ---
RESEND_API_KEY=
MAIL_FROM="AstroDicas <naoresponda@pnzdigital.com.br>"

# --- Painel interno de vendas ---
# O acesso normal é por CONTA (usuário + senha), guardada no banco, não aqui:
# cada operadora tem a sua, com o mercado que ela enxerga. Criar/atualizar:
#
#   ADMIN_SEED_PASSWORD='...' python scripts/seed_admin_users.py noelia --market all
#   ADMIN_SEED_PASSWORD='...' python scripts/seed_admin_users.py luciola --market AR
#
# Escopo `all` vê BR + AR e pode filtrar a visualização na tela; escopo BR ou
# AR fica preso ao seu mercado — e o filtro por URL é ignorado para essas
# contas, senão a separação entre equipes seria só enfeite.
#
# ADMIN_PASSWORD abaixo é a porta de emergência, com acesso total: serve para
# ninguém ficar trancado do lado de fora se as contas derem problema.
ADMIN_PASSWORD=

# --- Geração editorial das leituras ---
# Default endpoint (https://api.minimax.io/v1) and model (MiniMax-M2.7) are the
# working combination validated live on 2026-08-07 against an `sk-cp-` key.
# M2.7 benchmark: finish_reason=stop 3/3, 179-254 words, zero script leak.
# M2.1 is BANNED (caused 83% fallback — reasoning tokens ate the 550-token budget).
# M3 is BANNED (finish_reason=length 3/3, empty body — burns all 1800 tokens on reasoning).
# Do NOT change these unless the LLM provider rotates them.
MINIMAX_API_KEY=
LLM_BASE_URL=https://api.minimax.io/v1
LLM_MODEL_TEXT=MiniMax-M2.7
MINIMAX_TIMEOUT_SECONDS=120
# O modelo às vezes troca uma palavra solta por chinês/árabe/russo no meio da
# frase. O motor rejeita o texto e refaz a chamada até este número de vezes
# antes de cair no fallback editorial. 1 desliga a repetição (não recomendado:
# entrega leitura paga com ideograma).
MINIMAX_MAX_ATTEMPTS=3

# --- Pré-geração diária em lote (renewal.py) ---
# Espaçamento entre disparos consecutivos do pregen diário, pra não estourar
# concorrência do worker de uma vez.
PREGEN_STAGGER_SECONDS=3

# --- Geocodificação do local de nascimento ---
GEOCODING_ENABLED=1
GEOCODING_TIMEOUT_SECONDS=8

# --- Environment & controls ---
ENV=development
ALLOW_DEMO=0
ALLOW_INSECURE_DEV=0
ROLE=public
PORT=8080

# --- Timeouts (optional, defaults below) ---
RESEND_TIMEOUT_SECONDS=15
MP_TIMEOUT_SECONDS=20

# --- MiniMax aliases (fallback to LLM_* if not set) ---
# MINIMAX_BASE_URL defaults to LLM_BASE_URL if not provided
# MINIMAX_MODEL defaults to LLM_MODEL_TEXT if not provided
# MINIMAX_BASE_URL=
# MINIMAX_MODEL=

# --- Worker de geração (api/app/worker.py) ---
JOB_VISIBILITY_TIMEOUT_MINUTES=10
MINIMAX_MAX_CONCURRENCY=8
WORKER_POLL_INTERVAL_SECONDS=2
# 1 (padrão) = job esgotado fica "in_progress" e não entrega fallback editorial
# (fail-closed). 0 = volta a entregar fallback quando o modelo falha.
HOROSCOPE_FAIL_CLOSED=1

# --- Reset de senha ---
PASSWORD_RESET_TTL_SECONDS=1800

# --- Painel admin (api/app/admin.py) ---
# Teto de retentativas em lote no botão "Entregas do dia". Vazio = sem teto.
ADMIN_RETRY_BATCH_MAX=

# --- Web Push (VAPID) ---
# Ausência de qualquer uma desativa push notification, sem quebrar o resto.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:contato@astrodicas.com.br

# --- Rate limiting (in-memory, por IP, janela deslizante) ---
# RATE_LIMIT_ENABLED=0 desliga tudo. Nunca desligue em produção.
RATE_LIMIT_ENABLED=1
# Login/registro (site e admin): defesa contra brute-force de senha.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# Abertura de pedido de checkout.
RATE_LIMIT_CHECKOUT_MAX=20
RATE_LIMIT_CHECKOUT_WINDOW_SECONDS=60
# Webhooks (Cakto e Mercado Pago): a assinatura HMAC já barra forjar evento;
# isto é só anti-flood. Default alto de propósito — o Mercado Pago reenvia em
# burst quando o merchant fica offline, e perder um evento legítimo custa uma
# venda não liberada. Ajuste com cuidado.
RATE_LIMIT_WEBHOOK_MAX=120
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60
# Lista de IPs (separados por vírgula) que nunca são limitados, ex.: IPs
# oficiais do provedor de webhook fixados via firewall/allowlist.
RATE_LIMIT_BYPASS_IPS=
