# AstroDicas Site — variáveis do canal web.
# Copie para .env (nunca versionado) ou configure no Coolify.
# O Telegram tem as próprias credenciais: não reaproveite nada daqui lá.

# --- Núcleo ---
DATABASE_URL=postgresql+psycopg://astrodicas@db:5432/astrodicas
SITE_SECRET_KEY=troque-por-um-segredo-longo
SITE_ORIGIN=https://astrodicas.pnzdigital.com.br,https://dash.astrodicas.pnzdigital.com.br
SITE_PUBLIC_URL=https://astrodicas.pnzdigital.com.br
PORTAL_URL=https://dash.astrodicas.pnzdigital.com.br/
COOKIE_SECURE=1

# --- Checkout Mercado Pago (Argentina, transparente) ---
# Painel MP > Suas integrações > Credenciais. TEST-* em homologação, APP_USR-* em produção.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Painel MP > Webhooks > Clave secreta. Valida o header x-signature.
# Cada aplicação do MP tem a sua: a rota argentina
# (/api/webhooks/mercadopago/ar/notify) usa MP_WEBHOOK_SECRET_AR e é a que
# recebe as vendas de hoje. MP_WEBHOOK_SECRET serve só à rota legada
# (/api/webhooks/mercadopago/notify), mantida viva porque pagamentos abertos
# antes do deploy têm essa URL gravada e continuam sendo notificados nela.
# Enquanto MP_WEBHOOK_SECRET_AR não existir, a rota AR cai em MP_WEBHOOK_SECRET.
MP_WEBHOOK_SECRET_AR=
MP_WEBHOOK_SECRET=
MP_STATEMENT_DESCRIPTOR=ASTRODICAS
# Dias grátis do Plano Lua por assinatura. O período é do Mercado Pago
# (auto_recurring.free_trial): ele autoriza o cartão hoje e cobra no fim do prazo.
# Mudar aqui só afeta assinaturas NOVAS; as em andamento seguem o prazo com que
# nasceram, que está gravado no provedor.
TRIAL_DAYS=7

# --- Quem cobra em cada mercado ---
# Sem estas variáveis vale o padrão histórico: AR no Mercado Pago, BR na Cakto.
# Valores aceitos: mercadopago | cakto. Valor desconhecido cai no padrão e loga.
# Para o Brasil no Mercado Pago é preciso uma conta BRASILEIRA (MLB): contas do
# MP são presas ao país e a conta argentina (MLA) não cobra em BRL.
# CHECKOUT_PROVIDER_AR=mercadopago
# CHECKOUT_PROVIDER_BR=cakto

# --- Checkout Cakto (Brasil, link externo) ---
CAKTO_WEBHOOK_SECRET=

# --- E-mail transacional (Resend) ---
RESEND_API_KEY=
MAIL_FROM="AstroDicas <naoresponda@pnzdigital.com.br>"

# --- Painel interno de vendas ---
ADMIN_PASSWORD=

# --- Geração editorial das leituras ---
# Default endpoint (https://api.minimax.io/v1) and model (MiniMax-M2.1) are the
# working combination validated live on 2026-08-04 against an `sk-cp-` key.
# Do NOT change these unless the LLM provider rotates them.
MINIMAX_API_KEY=
LLM_BASE_URL=https://api.minimax.io/v1
LLM_MODEL_TEXT=MiniMax-M2.1
MINIMAX_TIMEOUT_SECONDS=120
# O modelo às vezes troca uma palavra solta por chinês/árabe/russo no meio da
# frase. O motor rejeita o texto e refaz a chamada até este número de vezes
# antes de cair no fallback editorial. 1 desliga a repetição (não recomendado:
# entrega leitura paga com ideograma).
MINIMAX_MAX_ATTEMPTS=3

# --- Geocodificação do local de nascimento ---
GEOCODING_ENABLED=1
GEOCODING_TIMEOUT_SECONDS=8

# --- Environment & controls ---
ENV=development
ALLOW_DEMO=0
ALLOW_INSECURE_DEV=0
ROLE=public
PORT=8080

# --- Timeouts (optional, defaults below) ---
RESEND_TIMEOUT_SECONDS=15
MP_TIMEOUT_SECONDS=20

# --- MiniMax aliases (fallback to LLM_* if not set) ---
# MINIMAX_BASE_URL defaults to LLM_BASE_URL if not provided
# MINIMAX_MODEL defaults to LLM_MODEL_TEXT if not provided
# MINIMAX_BASE_URL=
# MINIMAX_MODEL=

# --- Rate limiting (in-memory, por IP, janela deslizante) ---
# RATE_LIMIT_ENABLED=0 desliga tudo. Nunca desligue em produção.
RATE_LIMIT_ENABLED=1
# Login/registro (site e admin): defesa contra brute-force de senha.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# Abertura de pedido de checkout.
RATE_LIMIT_CHECKOUT_MAX=20
RATE_LIMIT_CHECKOUT_WINDOW_SECONDS=60
# Webhooks (Cakto e Mercado Pago): a assinatura HMAC já barra forjar evento;
# isto é só anti-flood. Default alto de propósito — o Mercado Pago reenvia em
# burst quando o merchant fica offline, e perder um evento legítimo custa uma
# venda não liberada. Ajuste com cuidado.
RATE_LIMIT_WEBHOOK_MAX=120
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60
# Lista de IPs (separados por vírgula) que nunca são limitados, ex.: IPs
# oficiais do provedor de webhook fixados via firewall/allowlist.
RATE_LIMIT_BYPASS_IPS=
